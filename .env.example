DATABASE_URL=postgres://user:password@localhost:5432/shagan_pos?sslmode=disable
PORT=8000
JWT_SECRET=changeme

# Shared secret for Shagan-team-only endpoints (e.g. POST /internal/accounts).
# Sent by the caller as the X-Internal-Key header. Required in every
# environment - if unset, /internal/* rejects all requests.
INTERNAL_API_KEY=changeme-internal-key

# Browser origins allowed to call this API cross-origin, comma-separated and
# exact (scheme + host + port), e.g. https://backoffice.shagan.example. Leave
# empty when every client reaches the API server-to-server (the Next.js
# frontends proxy it, so they need no CORS) or from tools like Postman, which
# send no Origin. A single "*" allows any origin - local development only.
CORS_ALLOWED_ORIGINS=

# Object storage (S3-compatible) for uploaded files - product images, payment
# QR codes, etc. MinIO locally (see docker-compose.yml); point these at real
# S3/R2/Spaces credentials in production, with STORAGE_USE_SSL=true.
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=shagan
STORAGE_SECRET_KEY=shagan12345
STORAGE_BUCKET=shagan-pos-media
STORAGE_USE_SSL=false
