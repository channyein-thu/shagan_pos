DATABASE_URL=postgres://user:password@localhost:5432/shagan_pos?sslmode=disable
PORT=8000
JWT_SECRET=changeme

# Shared secret for Shagan-team-only endpoints (e.g. POST /internal/accounts).
# Sent by the caller as the X-Internal-Key header. Required in every
# environment - if unset, /internal/* rejects all requests.
INTERNAL_API_KEY=changeme-internal-key
